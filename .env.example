# Public Firebase web configuration. These values identify a web app; never put
# service-account JSON, private keys, or other server secrets in this file.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# The Firebase Authentication UID allowed to use the private archive.
VITE_AOI_OWNER_UID=

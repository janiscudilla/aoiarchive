rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The sole authorized archive owner. All other users are denied.
    function isArchiveOwner() {
      return request.auth != null &&
        request.auth.uid == 'rzbJ6am5rjQlfE9C2CvBioKWiV13';
    }

    match /archives/{ownerUid}/scenes/{sceneId} {
      allow read, create, update, delete: if isArchiveOwner() &&
        ownerUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
